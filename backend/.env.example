DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/luminar

OPENAI_API_KEY=sk-...

# Google OAuth — console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Frontend origin (used as redirect_uri root for Google OAuth)
APP_URL=http://localhost:5173

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Supabase S3-compatible storage (auth is removed; storage stays)
# Dashboard → Project Settings → Storage → S3 Access
SUPABASE_URL=https://YOUR_REF.supabase.co
S3_ENDPOINT=https://YOUR_REF.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=luminar
